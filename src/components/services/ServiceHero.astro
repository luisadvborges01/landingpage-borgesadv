---
import { officeContact } from '../../data/professionalCards';
const { page, variant = 'editorial' } = Astro.props;
const secondaryHref = ({ 'beneficio-por-incapacidade': '#comparacao', 'aposentadoria-especial': '#tecnica', 'aposentadoria-rural': '#prova' } as Record<string, string>)[page.slug] ?? '#entenda';
const whatsapp = `${officeContact.links.whatsapp}?text=${encodeURIComponent(`Olá. Li a página sobre ${page.h1} e gostaria de entender como funciona o atendimento.`)}`;
---
<section class:list={['service-hero', `hero-${variant}`]} aria-labelledby="page-title">
  <div><p class="eyebrow">{page.eyebrow}</p><h1 id="page-title">{page.h1}</h1><p class="hero-lead">{page.lead}</p><p>{page.intro}</p><div class="actions"><a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer">{page.cta} <span aria-hidden="true">↗</span></a><a class="text-link" href={secondaryHref}>{page.secondary} <span aria-hidden="true">↓</span></a></div></div>
  <aside class="service-summary" aria-label="Em resumo"><p class="eyebrow">Em resumo</p><ul>{page.summary.map((point: string) => <li>{point}</li>)}</ul><p class="summary-note">Orientação informativa. Cada situação exige análise própria.</p></aside>
</section>
