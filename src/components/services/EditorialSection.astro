---
const { block, variant = 'split' } = Astro.props;
---
<section id={block.id} class:list={['section', 'editorial-section', `editorial-${variant}`]}>
  <div class="editorial-heading"><p class="eyebrow">{block.kicker}</p><h2>{block.title}</h2>{block.intro && <p>{block.intro}</p>}</div>
  <div class="editorial-body">{block.items.map((item: {title: string, text: string[]}) => <article><h3>{item.title}</h3>{item.text.map(p => <p>{p}</p>)}</article>)}</div>
  {block.example && <aside class="example"><p class="eyebrow">Exemplo hipotético</p><h3>{block.example.title}</h3><p>{block.example.text}</p></aside>}
  {block.link && <p class="section-link"><a class="text-link" href={block.link.href}>{block.link.label} <span aria-hidden="true">→</span></a></p>}
</section>
