# Google Wallet Generic Pass (mantenha desabilitado até concluir o onboarding)
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# Chave PEM em uma linha, usando \n para as quebras. Nunca use prefixo PUBLIC_.
GOOGLE_WALLET_PRIVATE_KEY=
# Origens HTTPS, separadas por vírgula. Ex.: https://borgesprev.com.br
GOOGLE_WALLET_ORIGINS=

# Apple Wallet permanece oculto até existir Pass Type ID e certificado válidos.
APPLE_WALLET_ENABLED=false
APPLE_WALLET_PASS_TYPE_ID=
